## Supabase
# Project Settings → API (copy Project URL from the top of that page)
NEXT_PUBLIC_SUPABASE_URL=

# Client key — use EITHER format (both work with this app):
#   New:  Publishable key  (sb_publishable_...)
#   Legacy tab: anon public JWT (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — use EITHER format:
#   New:  Secret key  (sb_secret_...) — click the eye icon to reveal, then copy
#   Legacy tab: service_role JWT (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=

# Optional (public): marketing copy shown on the Welcome screen
NEXT_PUBLIC_KANAM_SLOGAN=

# Optional (public): set to true only for demos; default behavior is to keep
# Data Analyst track locked until Python prerequisites are complete.
NEXT_PUBLIC_DATA_ANALYST_UNLOCK_FOR_TESTING=

# Server-only. Prevents random users from creating instructor accounts.
# Set this to a strong code and share it only with staff.
# Quote values that contain # or $ (those characters start comments / expansion in .env files).
INSTRUCTOR_INVITE_CODE=
