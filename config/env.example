## Supabase
# Project Settings → API (copy Project URL from the top of that page)
NEXT_PUBLIC_SUPABASE_URL=

# Client key — use EITHER format (both work with this app):
#   New:  Publishable key  (sb_publishable_...)
#   Legacy tab: anon public JWT (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — use EITHER format:
#   New:  Secret key  (sb_secret_...) — click the eye icon to reveal, then copy
#   Legacy tab: service_role JWT (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=

# Optional (public): marketing copy shown on the Welcome screen
NEXT_PUBLIC_KANAM_SLOGAN=

# Optional (public): main Kanam site for “Explore Kanam” in the app header.
# Default: https://www.kanamacademy.com
NEXT_PUBLIC_MARKETING_SITE_URL=

# Optional (legacy): Data Analyst is unlocked for everyone; this flag is unused.
NEXT_PUBLIC_DATA_ANALYST_UNLOCK_FOR_TESTING=

# Testing only: open every lesson (ignores class assignments / entitlements).
# Local/preview QA only — ignored automatically on Vercel Production.
KANAM_UNLOCK_ALL_LESSONS=
# Client + middleware unlock (no sign-in). Use with KANAM_UNLOCK_ALL_LESSONS for local capture/QA.
# Never enable on Vercel Production (even if set, the app ignores it there).
NEXT_PUBLIC_UNLOCK_ALL_LESSONS=

# Server-only. Prevents random users from creating instructor accounts.
# Set this to a strong code and share it only with staff.
# Quote values that contain # or $ (those characters start comments / expansion in .env files).
INSTRUCTOR_INVITE_CODE=

# Shared self-paced / async cohort (all solo learners use ONE class code).
# Preferred owner for first-time class creation (must be a real instructor auth user id).
# If unset/invalid, the app falls back to an existing class teacher or any instructor.
KANAM_ASYNC_CLASS_CODE=KANAM-ASYNC
KANAM_ASYNC_CLASS_NAME=Self-paced learners
KANAM_ASYNC_OWNER_USER_ID=

# Auth (Supabase Dashboard → Authentication → URL Configuration):
# Site URL: your production origin, e.g. https://learn.kanamacademy.com
# Redirect URLs must include:
#   https://learn.kanamacademy.com/**
#   https://learn.kanamacademy.com/auth/confirm
#   https://learn.kanamacademy.com/welcome/reset-password
# Password-reset emails: prefer TokenHash template (see supabase/README.md) so resets
# work across browsers/devices. Default PKCE links only work in the same browser.
#
# Student/parent signup requires email confirmation (email_confirm: false + resend).
# Enable Authentication → Providers → Email → "Confirm email" so unverified users
# cannot sign in until they open the confirmation link. Set NEXT_PUBLIC_APP_URL
# (or NEXT_PUBLIC_SITE_URL) so confirmation redirects point at this app.
NEXT_PUBLIC_APP_URL=

# Welcome emails (Resend) — branded signup email for students, parents, instructors.
# Create an API key at https://resend.com — verify your domain for production From addresses.
# Without RESEND_API_KEY, signup still works (welcome email skipped) and password
# reset falls back to Supabase’s mailer (often same-browser PKCE links).
RESEND_API_KEY=
# e.g. Kanam Academy <hello@learn.kanamacademy.com>
# Dev fallback if unset: Kanam Academy <onboarding@resend.dev>
RESEND_FROM_EMAIL=

# Error monitoring (Sentry) — optional locally; set in production.
# See docs/ops/error-monitoring.md
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Build-time only (source maps). Leave unset to skip upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stripe (live catalog — Price IDs also in lib/billing/stripe-catalog.ts)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Lesson slide "Listen" narration (OpenAI TTS). Without this, the app falls back
# to the device's robotic browser voice.
OPENAI_API_KEY=
# Optional: nova | shimmer | alloy | echo | fable | onyx (default nova)
OPENAI_TTS_VOICE=nova
# Optional: tts-1-hd (default, higher quality) or tts-1 (cheaper/faster)
OPENAI_TTS_MODEL=tts-1-hd
