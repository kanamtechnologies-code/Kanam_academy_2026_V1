## Supabase
# Project Settings → API (copy Project URL from the top of that page)
NEXT_PUBLIC_SUPABASE_URL=

# Client key — use EITHER format (both work with this app):
#   New:  Publishable key  (sb_publishable_...)
#   Legacy tab: anon public JWT (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — use EITHER format:
#   New:  Secret key  (sb_secret_...) — click the eye icon to reveal, then copy
#   Legacy tab: service_role JWT (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=

# Optional (public): marketing copy shown on the Welcome screen
NEXT_PUBLIC_KANAM_SLOGAN=

# Optional (legacy): Data Analyst is unlocked for everyone; this flag is unused.
NEXT_PUBLIC_DATA_ANALYST_UNLOCK_FOR_TESTING=

# Testing only: open every lesson for all signed-in students (ignores class assignments).
# Set to true while testing; leave unset/false for real teacher-gated classes.
KANAM_UNLOCK_ALL_LESSONS=

# Server-only. Prevents random users from creating instructor accounts.
# Set this to a strong code and share it only with staff.
# Quote values that contain # or $ (those characters start comments / expansion in .env files).
INSTRUCTOR_INVITE_CODE=

# Shared self-paced / async cohort (all solo learners use ONE class code).
# Create the class on first "Get a self-paced code" using this instructor auth user id as owner.
KANAM_ASYNC_CLASS_CODE=KANAM-ASYNC
KANAM_ASYNC_CLASS_NAME=Self-paced learners
KANAM_ASYNC_OWNER_USER_ID=

# Auth (Supabase Dashboard → Authentication → URL Configuration):
# Site URL: your production origin, e.g. https://learn.kanamacademy.com
# Redirect URLs must include:
#   https://learn.kanamacademy.com/**
#   https://learn.kanamacademy.com/auth/confirm
#   https://learn.kanamacademy.com/welcome/reset-password
# Password-reset emails: prefer TokenHash template (see supabase/README.md) so resets
# work across browsers/devices. Default PKCE links only work in the same browser.

# Stripe (live catalog — Price IDs also in lib/billing/stripe-catalog.ts)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
