## Supabase
# Get these from your Supabase project settings:
# - Project URL
# - anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (public): marketing copy shown on the Welcome screen
NEXT_PUBLIC_KANAM_SLOGAN=

# Optional (server-only). Required if you later do admin actions (manage users, etc.)
SUPABASE_SERVICE_ROLE_KEY=

